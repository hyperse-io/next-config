{
  "name": "@hyperse/next-config",
  "version": "1.0.7",
  "description": "Type-safe environment variables and runtime configuration patterns for Next.js applications",
  "keywords": [
    "config",
    "hyperse",
    "typescript",
    "next.js",
    "next.js env",
    "next.config.js",
    "next.config.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:hyperse-io/next-config.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./bin/",
    "./dist/",
    "./index.js"
  ],
  "scripts": {
    "build": "tsup",
    "changeset": "changeset",
    "cz": "cz",
    "lint": "eslint .",
    "lint-fix": "yarn lint --fix",
    "lint-staged-files": "lint-staged --allow-empty",
    "next": "next build",
    "prepare": "husky",
    "release": "yarn build && changeset publish",
    "test": "run-s test-unit",
    "test-task": "vitest run",
    "test-unit": "vitest run",
    "typecheck": "tsc --project ./tsconfig.json --noEmit"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "picocolors": "^1.1.1",
    "zod": "^4.6.7"
  },
  "resolutions": {
    "typescript": "6.x"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@types/node": "^26.6.5",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.12.0",
    "execa": "^10.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next": "^16.4.1",
    "npm-run-all": "^4.1.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "6.x",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "next": ">=15.0.1"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.11.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
